      {
        "id": "primary-loop",
        "label": "Observe, present, act",
        "focus": [
          "simulator",
          "tracker",
          "sidewindow",
          "simctl"
        ],
        "note": "The closed control loop: Simulator window state is observed, surfaced in the side panel, and acted on through the single simctl seam."
      },
      {
        "id": "capture-and-trust",
        "label": "Capture and TCC",
        "focus": [
          "tcc",
          "capture",
          "sidewindow",
          "simulator"
        ],
        "note": "ScreenCaptureKit work is preflighted against Screen Recording grants; a denied grant degrades to an honest caption instead of an error path."
      },
      {
        "id": "cross-process",
        "label": "Cross-process channel",
        "focus": [
          "channels",
          "framework",
          "sidewindow"
        ],
        "note": "The only cross-process wire: loopback TCP with Bonjour discovery between the host app and the DEBUG framework injected into Simulator apps."
      }
    ]
